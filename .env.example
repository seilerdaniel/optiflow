# ============================================================================
#  OPTIFLOW - Variables de entorno (Fase 7)
# ----------------------------------------------------------------------------
#  LOCAL  : copie este archivo a `.env` (install.bat lo crea) y complete la
#           cadena de Supabase. El servidor lo carga automáticamente.
#  VERCEL : configure las mismas variables en Project → Settings →
#           Environment Variables (all environments). NO suba `.env` al repo.
# ============================================================================

# Cadena de conexión de Supabase (rol `postgres`).
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# → usar el POOLER (puerto 6543), NO el directo (5432), para serverless.
# Alias aceptados: DATABASE_URL / POSTGRES_URL.
SUPABASE_DB_URL=postgres://postgres:PASSWORD@db.PROYECTO.supabase.co:6543/postgres

# Zona horaria de la planta (fechas "hoy" en métricas y firmas).
# Por defecto: America/Argentina/Buenos_Aires.
OPTIFLOW_TZ=America/Argentina/Buenos_Aires

# --- Opcionales ---
# Tamaño del pool de conexiones (por invocación serverless).
# PG_POOL_MAX=3
# Validación del certificado TLS del pooler ( Supabase usa cert propio;
# déjelo en 0 salvo que configure la CA de Supabase ).
# PG_SSL_VERIFY=0
# Fuerza/desactiva TLS (por defecto: TLS automático salvo localhost).
# PG_SSL=1
# Timeouts del pool (ms). Por defecto: PG_IDLE_MS=30000, PG_CONNECT_MS=10000.
# PG_IDLE_MS=30000
# PG_CONNECT_MS=10000

# Timeout de lectura del body de peticiones (ms). Por defecto 15000.
# READ_BODY_TIMEOUT_MS=15000

# No abrir el navegador al iniciar el servidor local (start.bat).
# OPTIFLOW_NO_BROWSER=1

# ============================================================================
#  SEGURIDAD (auditoría V-1 / V-2) — Fase 7 hardening
# ============================================================================
# Usuario admin inicial. Si la tabla `usuarios` está vacía, el primer arranque
# crea este usuario; la contraseña sale de OPTIFLOW_ADMIN_PASSWORD o se genera
# aleatoria y se imprime UNA sola vez en consola.
# OPTIFLOW_ADMIN_USER=admin
# OPTIFLOW_ADMIN_PASSWORD= cambiar-esta-clave
# OPTIFLOW_ADMIN_NOMBRE=Administrador

# Duración de las sesiones (horas). Por defecto 12 h.
# OPTIFLOW_SESION_HORAS=12

# Intentos máximos de login por IP+usuario cada 15 minutos. Por defecto 8.
# OPTIFLOW_LOGIN_MAX=8

# Token estático para la exportación SIN sesión (Power BI / refresh programado).
# Se envía como header X-Optiflow-Token o como ?token=… en /api/export/*.
# Si NO se define y no hay sesión, la exportación responde 401.
# OPTIFLOW_EXPORT_TOKEN=token-largo-y-secreto

# Orígenes CORS adicionales permitidos (coma-separados). Por defecto SÓLO se
# acepta el mismo origen; cualquier otro dominio queda bloqueado.
# OPTIFLOW_CORS_ORIGINS=https://mi-dominio.vercel.app

# Fuerza los mensajes técnicos de error 500 aunque NODE_ENV=production.
# Sólo para diagnóstico: déjelo sin definir en producción.
# OPTIFLOW_DEBUG=1

# ============================================================================
#  NOTIFICACIONES AUTOMATIZADAS (WhatsApp / Telegram) — Jefatura de Planta
# ----------------------------------------------------------------------------
#  CERO dependencias npm: el envío usa `fetch` nativo contra un webhook/gateway
#  de WhatsApp y contra la Bot API de Telegram. Nada de SDKs.
#
#  NUNCA rompe la aplicación: si no hay internet o el gateway responde mal, la
#  notificación falla en silencio (se loguea) y el fichado de planta sigue.
# ============================================================================

# Interruptor maestro. Mientras esté en false (o vacío) NO se envía nada,
# aunque el resto esté configurado. Deje false en desarrollo local.
NOTIFICACIONES_HABILITADAS=false

# Endpoint del gateway de WhatsApp. Debe aceptar un POST JSON.
# El cuerpo enviado es:
#   { "event":"message", "text":"<mensaje>", "message":"<mensaje>",
#     "tipo":"<evento>", "origen":"optiflow", "enviado_en":"<ISO UTC>" }
# Ejemplos de gateways: Evolution API (…/message/sendText), Baileys propio,
# Twilio (requiere adaptar el payload), o un middleware interno.
# WHATSAPP_WEBHOOK_URL=https://api.evolution.example.com/message/sendText/APIKEY

# Telegram: el mismo mensaje se envía en paralelo si definís estos dos.
# Crear el bot con @BotFather y obtener el chat_id con @userinfobot.
# TELEGRAM_BOT_TOKEN=123456789:AA...XXXXXXXXXXXXXXXXXXXX
# TELEGRAM_CHAT_ID=-1001234567890

# Timeout de cada petición saliente (ms). Por defecto 8000.
# NOTIFICACIONES_TIMEOUT_MS=8000

# --- Tareas programadas (alertas de tiempo excedido + resumen diario) ---
# Endpoint disparado por un cron EXTERNO (Vercel Cron, GitHub Actions, schtasks
# de Windows, etc.). Se autentica con sesión de gestión o con este token, que se
# envía como header X-Optiflow-Token o como ?token=…
#   POST /api/cron/alertas-excedidas?forzar=1
#   POST /api/cron/resumen-diario
#   GET  /api/cron/estado
# OPTIFLOW_CRON_TOKEN=token-largo-y-secreto-para-el-cron

