{
  "name": "optiflow",
  "version": "7.0.0",
  "description": "Optiflow - Plataforma Web de Control de Tiempos y Trazabilidad en Planta (De Otro Tiempo). Fase 7: Supabase + Vercel + PWA.",
  "private": true,
  "main": "server/server.js",
  "scripts": {
