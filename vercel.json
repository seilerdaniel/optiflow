{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/[...slug].js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/admin.js": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/admin",
        "destination": "/api/admin"
      },
      {
        "source": "/admin.html",
        "destination": "/api/admin"
      }
    ],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "/api/[...slug]"
      }
    ]
  }
}
